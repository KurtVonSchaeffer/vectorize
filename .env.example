# Online font identification (WhatFontIs). Server-side only: never prefix with VITE_.
# Get a key at https://www.whatfontis.com/API-identify-fonts-from-image.html, then copy this
# file to .env.local and restart the dev server.
WHATFONTIS_API_KEY=

# Admin panel build (docs/admin-panel.md): on, preview (?admin=on for one visit) or empty.
VITE_ADMIN_MODE=
# The vectoriser microservice for runs, reviews and learned defaults. Empty keeps them in the browser.
VITE_RUNS_API_URL=
# The build's commit, stored with every run.
VITE_ENGINE_VERSION=

# Where the app sends font searches in production (the deployed edge function).
# Deployed: https://bkctlugpzwbdzoozrncm.supabase.co/functions/v1/identify-font
# Leave empty to use the dev/preview server's built-in /api/identify-font.
VITE_FONT_API_URL=
